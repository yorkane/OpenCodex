# Original app bundle (reference only)
Codex.app/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
out/
dist/
release/
# deb 打包的暂存目录（由 packaging/linux/build-deb.sh 生成）
build/
# 离线 payload：随包安装的第三方 .deb（node 运行时、官方 code-app 等），体积大，不入库
packaging/linux/payload/

# Local runtime data
.data/
cache/
official-user-data/
reports/

# Upstream ASAR extracts and build-time copies (all generated)
src/
!gateway/src/
!gateway/src/**
!web-shell/src/
!web-shell/src/**
# v2 插件示例源码需要随仓库发布，避免通用上游源码规则误过滤。
!examples/plugin-v2-hello/src/
!examples/plugin-v2-hello/src/**

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local
config.yaml
# 上面的 config.yaml 针对运行时配置；打包用的站点配置模板必须入库。
!packaging/linux/etc/config.yaml

# Temporary files
# 浏览器验证工具的会话产物（playwright-cli 生成）
.playwright-cli/
*.tmp
*.temp

# Native binaries (downloaded via package manager in CI)
resources/bin/
resources/codex
resources/codex.exe
.claude/
