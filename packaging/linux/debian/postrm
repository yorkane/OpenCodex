#!/bin/sh
# 移除/清除后的收尾：purge 时连同状态目录与服务账户一起清理。
set -e

STATE_DIR=/var/lib/opencodex
LOG_DIR=/var/log/opencodex

case "$1" in
  remove)
    systemctl disable opencodex-gateway.service opencodex-xvfb.service opencodex-payload.service >/dev/null 2>&1 || true
    ;;
  purge)
    systemctl disable opencodex-gateway.service opencodex-xvfb.service >/dev/null 2>&1 || true
    rm -f /var/lib/opencodex/.payload-installed
    rm -rf "$STATE_DIR" "$LOG_DIR"
    if getent passwd opencodex >/dev/null 2>&1; then
      deluser opencodex >/dev/null 2>&1 || true
    fi
    if getent group opencodex >/dev/null 2>&1; then
      delgroup opencodex >/dev/null 2>&1 || true
    fi
    ;;
esac

systemctl daemon-reload >/dev/null 2>&1 || true
exit 0
